---
const stars = [
  { top:  12, left:  8,  size: 1,   duration: 2.8, delay: 0.0, gold: false },
  { top:   6, left: 22,  size: 1,   duration: 3.5, delay: 0.7, gold: true  },
  { top:  18, left: 38,  size: 1,   duration: 2.2, delay: 1.4, gold: false },
  { top:   9, left: 52,  size: 1.5, duration: 4.1, delay: 0.3, gold: true  },
  { top:  15, left: 67,  size: 1,   duration: 3.0, delay: 2.1, gold: false },
  { top:   5, left: 79,  size: 1,   duration: 2.6, delay: 0.9, gold: false },
  { top:  22, left: 91,  size: 1,   duration: 3.8, delay: 1.8, gold: true  },
  { top:  45, left: 15,  size: 1,   duration: 2.4, delay: 3.2, gold: false },
  { top:  72, left: 33,  size: 1,   duration: 3.3, delay: 1.1, gold: false },
  { top:  60, left: 85,  size: 1.5, duration: 4.5, delay: 2.7, gold: true  },
  { top:  80, left: 95,  size: 1,   duration: 2.9, delay: 0.5, gold: false },
  { top:  88, left: 47,  size: 1,   duration: 3.7, delay: 3.9, gold: false },
  { top:  77, left:  6,  size: 1,   duration: 2.1, delay: 2.3, gold: true  },
  { top:  40, left: 72,  size: 1.5, duration: 3.4, delay: 1.6, gold: false },
  { top:  30, left: 58,  size: 1,   duration: 4.2, delay: 0.4, gold: false },
  { top:  55, left: 25,  size: 1,   duration: 2.7, delay: 3.1, gold: true  },
  { top:  65, left: 62,  size: 1,   duration: 3.1, delay: 2.5, gold: false },
  { top:  20, left: 44,  size: 1,   duration: 2.3, delay: 4.4, gold: false },
  { top:  35, left:  3,  size: 1,   duration: 3.6, delay: 1.9, gold: false },
  { top:  92, left: 70,  size: 1,   duration: 2.5, delay: 0.8, gold: true  },
];
---
<section class="hero">
  <!-- Individual twinkling stars -->
  {stars.map((s) => (
    <span
      class:list={['star', s.gold ? 'star-gold' : '']}
      style={`top:${s.top}%;left:${s.left}%;width:${s.size}px;height:${s.size}px;--dur:${s.duration}s;--del:${s.delay}s`}
      aria-hidden="true"
    ></span>
  ))}

  <!-- Shooting star -->
  <div class="shooting-star" aria-hidden="true"></div>

  <!-- Moon -->
  <img class="moon" src="/moon.jpg" alt="" aria-hidden="true" />

  <div class="hero-inner">
    <div class="hero-text">
      <p class="section-eyebrow">Space City Books</p>
      <h1 class="hero-headline">
        A signature is only as good as
        <em>the witness behind it.</em>
      </h1>
      <p class="hero-description">
        Space City Books serves as an independent third-party witness to signings at conventions —
        issuing Certificates of Authentication that collectors can trust.
      </p>
      <div class="gold-rule"></div>
      <p class="hero-motto">— <span>Lux Revelare</span> — Light Reveals —</p>
    </div>

    <div class="hero-cert">
      <div class="cert-wrapper">
        <img
          src="/coa-certificate.png"
          alt="Space City Books Certificate of Authentication — official document certifying an independent third-party witness was present at a signing"
          width="600"
          height="400"
        />
        <div class="cert-seal-wrapper" aria-hidden="true">
          <img src="/Space City Books Seal 2.png" alt="" class="cert-seal cert-seal-base" />
          <img src="/Space City Books Seal 2.png" alt="" class="cert-seal cert-seal-glow" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 3rem;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(27, 42, 74, 0.13) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 30%, rgba(201, 168, 76, 0.03) 0%, transparent 50%),
      var(--bg-deep);
  }

  /* ── Individual twinkling stars ── */
  .star {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    pointer-events: none;
    animation: twinkle var(--dur) ease-in-out infinite;
    animation-delay: var(--del);
  }
  .star-gold { background: rgba(201, 168, 76, 0.85); }

  @keyframes twinkle {
    0%, 100% { opacity: 1;    transform: scale(1);   }
    50%       { opacity: 0.1; transform: scale(0.4); }
  }

  /* ── Shooting star ── */
  .shooting-star {
    position: absolute;
    width: 160px;
    height: 1.5px;
    border-radius: 50%;
    background: linear-gradient(to left, transparent, rgba(255,255,255,0.9) 60%, rgba(201,168,76,0.6));
    transform: rotate(-30deg);
    opacity: 0;
    pointer-events: none;
  }
  .shooting-star::after {
    content: '';
    position: absolute;
    right: 0;
    top: -1px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 4px 1px rgba(201, 168, 76, 0.6);
  }
  .shooting-star.active {
    animation: shoot 0.75s ease-out forwards;
  }

  @keyframes shoot {
    0%   { opacity: 1; transform: rotate(-30deg) translateX(0);      }
    70%  { opacity: 0.8; }
    100% { opacity: 0; transform: rotate(-30deg) translateX(-420px); }
  }

  /* ── Moon ── */
  .moon {
    position: absolute;
    top: 2.5rem;
    right: 3.5rem;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    opacity: 0.95;
    pointer-events: none;
    box-shadow: 0 0 2rem rgba(201, 168, 76, 0.35), 0 0 6rem rgba(201, 168, 76, 0.15);
    filter: brightness(1.2) contrast(1.05);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4.5rem;
    max-width: 1200px;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: normal;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .hero-headline em {
    display: block;
    color: var(--gold);
    font-style: italic;
  }
  .hero-description {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.75;
    max-width: 27.5rem;
    margin-top: 1.25rem;
  }
  .hero-motto {
    font-size: 0.625rem;
    letter-spacing: 0.1875rem;
    text-transform: uppercase;
    color: rgba(201,168,76,0.53);
    font-family: var(--font-sans);
  }
  .hero-motto span { color: var(--gold); }

  .cert-wrapper {
    position: relative;
    transform: rotate(1.5deg);
    transition: transform 0.4s ease;
  }
  .cert-wrapper:hover { transform: rotate(0deg) scale(1.02); }
  .cert-wrapper > img:first-child {
    width: 100%;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px rgba(201,168,76,0.2),
      0 0 2.5rem rgba(201,168,76,0.1),
      0 1.5rem 5rem rgba(0,0,0,0.7);
  }

  .cert-seal-wrapper {
    position: absolute;
    bottom: 12%;
    right: 6%;
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    box-shadow:
      0 0 6px 3px rgba(138, 43, 226, 0.85),
      0 0 14px 6px rgba(100, 0, 255, 0.65),
      0 0 30px 12px rgba(75, 0, 200, 0.4),
      0 0 54px 22px rgba(50, 0, 180, 0.2);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
    animation: uv-pulse 3s ease-in-out infinite;
  }

  .cert-seal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .cert-seal-base {
    mix-blend-mode: multiply;
  }

  .cert-seal-glow {
    mix-blend-mode: screen;
    animation: uv-seal-pulse 3s ease-in-out infinite;
  }

  @keyframes uv-pulse {
    0%, 100% {
      box-shadow:
        0 0 8px 4px rgba(160, 60, 255, 0.9),
        0 0 18px 8px rgba(130, 10, 255, 0.75),
        0 0 40px 16px rgba(100, 0, 230, 0.5),
        0 0 70px 28px rgba(70, 0, 200, 0.25);
    }
    50% {
      box-shadow:
        0 0 12px 6px rgba(180, 80, 255, 1),
        0 0 26px 12px rgba(140, 20, 255, 0.95),
        0 0 55px 24px rgba(110, 0, 235, 0.65),
        0 0 95px 42px rgba(75, 0, 210, 0.35),
        0 0 130px 60px rgba(45, 0, 170, 0.18);
    }
  }

  @keyframes uv-seal-pulse {
    0%, 100% {
      filter: invert(1) sepia(1) saturate(3) hue-rotate(220deg) brightness(0.08);
    }
    50% {
      filter: invert(1) sepia(1) saturate(7) hue-rotate(220deg) brightness(1.4);
    }
  }

  @media (max-width: 768px) {
    .hero { padding: 5rem 1.5rem 3rem; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-cert { max-width: 30rem; margin: 0 auto; width: 100%; }
    .cert-wrapper        { transform: none; }
    .cert-wrapper:hover  { transform: none; }
  }
</style>

<script>
  function launchShootingStar() {
    const star = document.querySelector('.shooting-star') as HTMLElement;
    if (!star) return;

    // Random position in the upper portion of the hero
    star.style.top  = (4  + Math.random() * 35) + '%';
    star.style.left = (25 + Math.random() * 55) + '%';

    star.classList.add('active');

    star.addEventListener('animationend', () => {
      star.classList.remove('active');
      // Next shooting star in 4–12 seconds
      setTimeout(launchShootingStar, 4000 + Math.random() * 8000);
    }, { once: true });
  }

  // First appearance after 2–5 seconds
  setTimeout(launchShootingStar, 2000 + Math.random() * 3000);
</script>
